@eval
const A = app.vault.adapter;
const probeDir = ".obsidian/plugins/obsidian-probe";
await A.mkdir(probeDir).catch(() => {});
await A.write(
  `${probeDir}/manifest.json`,
  JSON.stringify({
    id: "obsidian-probe",
    name: "Obsidian probe",
    version: "1.0.0",
    minAppVersion: "1.0.0",
    description: "Probe helper: stashes the obsidian module on window (#431).",
    author: "rss-dashboard probe",
    isDesktopOnly: false,
  }),
);
await A.write(
  `${probeDir}/main.js`,
  'const o=require("obsidian");class P extends o.Plugin{onload(){window.__obsidianApi=o}}module.exports=P;',
);
await app.plugins.setEnable(true);
await app.plugins.loadManifests();
if (!app.plugins.plugins["obsidian-probe"]) {
  await app.plugins.enablePluginAndSave("obsidian-probe");
}
await new Promise((r) => window.setTimeout(r, 300));
const api = window.__obsidianApi;
typeof api

@eval
const notice = new api.Notice("Hello probe", 0);
const ownKeys = Object.keys(notice);
const proto = Object.getOwnPropertyNames(Object.getPrototypeOf(notice));
const el = notice.noticeEl ?? notice.containerEl ?? null;
const shape = {
  ownKeys,
  proto,
  hasNoticeEl: !!notice.noticeEl,
  hasContainerEl: !!notice.containerEl,
  hasMessageEl: !!notice.messageEl,
  elClass: el?.className ?? null,
  elRole: el?.getAttribute("role") ?? null,
  text: el?.textContent ?? null,
};
notice.hide();
JSON.stringify(shape)

@eval
const n = new Notice("Global notice", 0);
JSON.stringify({
  globalInstanceOwnKeys: Object.keys(n),
  globalHasHide: typeof n.hide,
  globalElClass: n.noticeEl?.className ?? null,
  sameCtor: n.constructor === api.Notice,
})
