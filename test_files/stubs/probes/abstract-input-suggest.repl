@eval
const A = app.vault.adapter;
const probeDir = ".obsidian/plugins/obsidian-probe";
await A.mkdir(probeDir).catch(() => {});
await A.write(
  `${probeDir}/manifest.json`,
  JSON.stringify({
    id: "obsidian-probe",
    name: "Obsidian probe",
    version: "1.0.0",
    minAppVersion: "1.0.0",
    description: "Probe helper: stashes the obsidian module on window (#431).",
    author: "rss-dashboard probe",
    isDesktopOnly: false,
  }),
);
await A.write(
  `${probeDir}/main.js`,
  'const o=require("obsidian");class P extends o.Plugin{onload(){window.__obsidianApi=o}}module.exports=P;',
);
await app.plugins.setEnable(true);
await app.plugins.loadManifests();
if (!app.plugins.plugins["obsidian-probe"]) {
  await app.plugins.enablePluginAndSave("obsidian-probe");
}
await new Promise((r) => window.setTimeout(r, 300));
const api = window.__obsidianApi;
typeof api

@eval
// Surface (#1376). The popover renders into the ACTIVE window's body, so close
// the Settings popout that version-and-platform.repl leaves open first.
app.setting.close();
await new Promise((r) => window.setTimeout(r, 300));
const api = window.__obsidianApi;
const proto = Object.getOwnPropertyNames(api.AbstractInputSuggest.prototype);
// Clear anything an interrupted earlier run left behind.
document
  .querySelectorAll(
    ".ais-probe, .ais-probe-select, .ais-probe-async, .suggestion-container",
  )
  .forEach((e) => e.remove());
await (async () => {
  const host = document.body.createDiv({ cls: "ais-probe" });
  const input = host.createEl("input", { type: "text" });
  class AisSurface extends api.AbstractInputSuggest {
    getSuggestions() {
      return [];
    }
    renderSuggestion() {}
  }
  const attrsBefore = input.getAttributeNames();
  const s = new AisSurface(app, input);
  const result = JSON.stringify({
    mainWindowActive: activeWindow === window && activeDocument === document,
    proto,
    baseIsPopoverSuggest: api.PopoverSuggest.prototype.isPrototypeOf(
      api.AbstractInputSuggest.prototype,
    ),
    popoverProto: Object.getOwnPropertyNames(api.PopoverSuggest.prototype),
    ownStatic: Object.getOwnPropertyNames(api.AbstractInputSuggest),
    abstractOnPrototype: {
      getSuggestions: "getSuggestions" in api.AbstractInputSuggest.prototype,
      renderSuggestion: "renderSuggestion" in api.AbstractInputSuggest.prototype,
    },
    ctorLength: api.AbstractInputSuggest.length,
    ownKeys: Object.keys(s),
    limit: s.limit,
    isOpen: s.isOpen,
    appIsApp: s.app === app,
    textInputEl: s.textInputEl === input,
    inputEl: typeof s.inputEl,
    scopeParentIsAppScope: s.scope.parent === app.scope,
    scopeKeys: s.scope.keys.map((k) => [k.modifiers, k.key]),
    suggestElClass: s.suggestEl.className,
    suggestInnerElClass: s.suggestInnerEl.className,
    suggestElConnected: s.suggestEl.isConnected,
    inputAttrsUnchanged:
      JSON.stringify(attrsBefore) === JSON.stringify(input.getAttributeNames()),
  });
  host.remove();
  return result;
})()

@eval
// Wiring: setValue/getValue, focus/input/blur, the popover DOM. Keeps the
// suggest on window.__ais for the keyboard steps below.
const api = window.__obsidianApi;
const wait = (ms) => new Promise((r) => window.setTimeout(r, ms));
document.querySelectorAll(".ais-probe").forEach((e) => e.remove());
await (async () => {
  const host = document.body.createDiv({ cls: "ais-probe" });
  const input = host.createEl("input", { type: "text" });
  const log = [];
  class AisWiring extends api.AbstractInputSuggest {
    getSuggestions(q) {
      log.push(["getSuggestions", q]);
      return ["alpha", "beta", "gamma"].filter((v) => v.includes(q));
    }
    renderSuggestion(v, el) {
      log.push(["renderSuggestion", v, el.className]);
      el.setText(v);
    }
    open() {
      log.push("open");
      return super.open();
    }
    close() {
      log.push("close");
      return super.close();
    }
  }
  const s = new AisWiring(app, input);
  window.__ais = { s, input, log, host };
  window.__aisSel = () =>
    [...s.suggestEl.querySelectorAll(".suggestion-item")]
      .map((e) => e.textContent + (e.classList.contains("is-selected") ? "*" : ""))
      .join(",");
  window.__aisSnap = () => ({
    log: JSON.parse(JSON.stringify(log.splice(0))),
    isOpen: s.isOpen,
    containers: document.querySelectorAll(".suggestion-container").length,
    active: document.activeElement === input,
    input: input.value,
  });
  const out = {};
  let inputEvents = 0;
  let changeEvents = 0;
  input.addEventListener("input", () => inputEvents++);
  input.addEventListener("change", () => changeEvents++);
  const ret = s.setValue("be");
  out.setValue = {
    ret: String(ret),
    getValue: s.getValue(),
    inputValue: input.value,
    inputEvents,
    changeEvents,
    ...window.__aisSnap(),
  };
  input.value = "gam";
  out.getValueAfterDirectWrite = s.getValue();
  input.dispatchEvent(new Event("input", { bubbles: true }));
  out.inputEventWhileBlurred = window.__aisSnap();
  input.focus();
  out.focus = window.__aisSnap();
  out.container = {
    isSuggestEl: s.suggestEl === document.querySelector(".suggestion-container"),
    parentIsBody: s.suggestEl.parentElement === document.body,
    innerIsSuggestInnerEl: s.suggestEl.firstElementChild === s.suggestInnerEl,
    html: s.suggestEl.outerHTML,
  };
  input.value = "bet";
  input.dispatchEvent(new Event("input", { bubbles: true }));
  out.syncRenderOnInput = { sel: window.__aisSel(), ...window.__aisSnap() };
  input.blur();
  out.blur = window.__aisSnap();
  await wait(300);
  out.blurAfter300ms = window.__aisSnap();
  input.focus();
  window.__aisSnap();
  s.close();
  window.__aisSnap();
  input.click();
  out.clickWhileFocusedAfterClose = window.__aisSnap();
  input.blur();
  window.__aisSnap();
  return JSON.stringify(out);
})()

@eval
// Keyboard (real keys through @key). Empty input, so all three rows show.
const { s, input, log } = window.__ais;
input.value = "";
input.focus();
JSON.stringify({ focus: window.__aisSnap(), sel: window.__aisSel() })

