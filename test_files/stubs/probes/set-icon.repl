@eval
const A = app.vault.adapter;
const probeDir = ".obsidian/plugins/obsidian-probe";
await A.mkdir(probeDir).catch(() => {});
await A.write(
  `${probeDir}/manifest.json`,
  JSON.stringify({
    id: "obsidian-probe",
    name: "Obsidian probe",
    version: "1.0.0",
    minAppVersion: "1.0.0",
    description: "Probe helper: stashes the obsidian module on window (#431).",
    author: "rss-dashboard probe",
    isDesktopOnly: false,
  }),
);
await A.write(
  `${probeDir}/main.js`,
  'const o=require("obsidian");class P extends o.Plugin{onload(){window.__obsidianApi=o}}module.exports=P;',
);
await app.plugins.setEnable(true);
await app.plugins.loadManifests();
if (!app.plugins.plugins["obsidian-probe"]) {
  await app.plugins.enablePluginAndSave("obsidian-probe");
}
await new Promise((r) => window.setTimeout(r, 300));
const api = window.__obsidianApi;
typeof api

@eval
const el = createDiv();
api.setIcon(el, "play");
const unknown = createDiv();
api.setIcon(unknown, "definitely-not-an-icon");
const getIconResult = api.getIcon("play");
JSON.stringify({
  knownIconHtml: el.innerHTML,
  unknownIconHtml: unknown.innerHTML,
  knownChildTag: el.firstElementChild?.tagName ?? null,
  knownChildClass: el.firstElementChild?.getAttribute("class") ?? null,
  getIconTag: getIconResult?.tagName ?? null,
  getIconClass: getIconResult?.getAttribute("class") ?? null,
  getIconIdsIncludesPlay: api.getIconIds().includes("play"),
  getIconIdsLength: api.getIconIds().length,
})

@eval
const rss = createDiv();
api.setIcon(rss, "rss");
const trash = createDiv();
api.setIcon(trash, "trash");
const getIconRss = api.getIcon("rss");
JSON.stringify({
  rssIconHtml: rss.innerHTML,
  trashIconHtml: trash.innerHTML,
  getIconRssHtml: getIconRss?.outerHTML ?? null,
})

@eval
const reused = createDiv({ text: "old content" });
api.setIcon(reused, "play");
const switched = createDiv();
api.setIcon(switched, "play");
api.setIcon(switched, "rss");
JSON.stringify({
  reusedHtml: reused.innerHTML,
  reusedChildCount: reused.childElementCount,
  switchedHtml: switched.innerHTML,
  switchedClass: switched.firstElementChild?.getAttribute("class") ?? null,
})

@eval
const cases = [
  "trash",
  "pencil",
  "folder",
  "fullscreen",
  "link",
  "star-off",
  "youtube",
];
const renderedClass = {};
for (const name of cases) {
  const host = createDiv();
  api.setIcon(host, name);
  renderedClass[name] = host.firstElementChild?.getAttribute("class") ?? null;
}
JSON.stringify(renderedClass)

@eval
const names = ["circle-check-big", "eraser", "check-circle", "x", "save", "rotate-ccw"];
const resolved = {};
for (const name of names) {
  const host = createDiv();
  api.setIcon(host, name);
  const svg = host.firstElementChild;
  resolved[name] = svg
    ? { class: svg.getAttribute("class"), body: svg.innerHTML }
    : null;
}
JSON.stringify(resolved)
