#!/bin/sh

if [ "$SKIP_GIT_HOOKS" = "1" ]; then
  echo "[pre-commit] SKIP_GIT_HOOKS=1 set, skipping."
  exit 0
fi

echo "[pre-commit] Running compliance checks..."
npm run --silent check:compliance
if [ $? -ne 0 ]; then
  exit 1
fi

# Lints staged files and runs the unit tests related to them. The full lint,
# type-check, build, and test suite run in pre-push and CI.
node scripts/run-staged-checks.mjs
