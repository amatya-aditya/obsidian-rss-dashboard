# Runtime-only, fully synthetic credentials for the disposable FreshRSS
# Docker read-contract instance. These are not secrets: the container they
# authenticate is created fresh, torn down (including its volume) at the end
# of every contract run, and never exposed outside localhost. Safe to commit.
#
# Do not reuse these values for a real FreshRSS deployment.

FRESHRSS_PUBLISHED_PORT=8090
FRESHRSS_ADMIN_USER=contract-admin
FRESHRSS_ADMIN_PASSWORD=contract-password-not-a-secret
FRESHRSS_ADMIN_API_PASSWORD=contract-api-password-not-a-secret
