{
  "name": "rss-dashboard",
  "version": "2.7.0-beta.2",
  "description": "RSS dashboard for Obsidian",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "check:css-scope": "node scripts/check-css-scope.js",
    "check:platform": "node scripts/check-platform-compat.mjs",
    "check:important": "node scripts/check-css-important.mjs",
    "check:test-types": "tsc -noEmit -skipLibCheck -incremental -tsBuildInfoFile node_modules/.cache/tsc/tests.tsbuildinfo -p test_files/tsconfig.json",
    "check:compliance": "npm run check:css-scope && npm run check:platform && npm run check:important && npm run check:commit-message && npm run check:release-compatibility && npm run check:pre-release && npm run check:doc-links",
    "check:commit-message": "node scripts/check-commit-message.mjs",
    "check:release-compatibility": "node scripts/check-release-compatibility.mjs",
    "check:pre-release": "node scripts/check-pre-release.mjs",
    "check:doc-links": "node scripts/check-doc-links.mjs",
    "check:release-ready": "node scripts/check-release-ready.mjs",
    "build": "npm run check:compliance && npm run lint && tsc -noEmit -skipLibCheck -incremental -tsBuildInfoFile node_modules/.cache/tsc/main.tsbuildinfo && npm run check:test-types && node esbuild.config.mjs production",
    "lint": "eslint . --max-warnings=0",
    "lint:dev": "eslint .",
    "test:unit": "vitest run --config vitest.config.mjs",
    "hooks:install": "node scripts/setup-git-hooks.mjs",
    "prepare": "npm run hooks:install",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20.19.0"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.0.0",
    "@typescript-eslint/parser": "^8.69.0",
    "@typescript-eslint/utils": "^8.69.0",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild": "0.28.2",
    "eslint": "^9.39.2",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.12.0",
    "jsdom": "^28.1.0",
    "moment": "^2.30.1",
    "obsidian": "1.13.1",
    "postcss": "^8.5.28",
    "postcss-selector-parser": "^7.1.6",
    "prettier": "^3.9.6",
    "tslib": "2.8.1",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "turndown": "^7.2.4"
  }
}
